USE_OLLAMA=1
OLLAMA_HOST=http://host.docker.internal:11434
SYSTEM_ONE_MODEL=gemma4:e2b
SYSTEM_TWO_MODEL=gemma4:12b

# Optional fallback if you want OpenRouter instead of Ollama
# OPENROUTER_API_KEY=

# Optional provider ordering
BTC_PRICE_PROVIDERS=coingecko,binance,coinbase,kraken
BTC_HISTORY_PROVIDERS=coingecko,binance,kraken
